{
  "name": "eurosortex-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prepare-release.mjs",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "bot": "node --experimental-strip-types --env-file-if-exists=.env.bot bot/server.mjs",
    "bot:test": "node --experimental-strip-types --test bot/*.test.mjs",
    "bot:cloudflare:build": "node bot/cloudflare/build.mjs",
    "bot:cloudflare:test": "node bot/cloudflare/build.mjs && node --experimental-strip-types --test bot/cloudflare/*.test.mjs",
    "bot:catalog:sync": "python3 bot/sync-catalog.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/manrope": "^5.2.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "astro": "^7.0.9",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3"
  }
}
