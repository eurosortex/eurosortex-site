---
interface Props {
  size?: number;
}

const { size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"></rect>
  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"></circle>
  <circle cx="17.4" cy="6.6" r="1" fill="currentColor"></circle>
</svg>
