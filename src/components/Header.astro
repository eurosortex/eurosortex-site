---
import { storefront } from '../i18n/storefront';
import { Image } from 'astro:assets';
import { imageAsset } from '../lib/images';
import TopBar from './TopBar.astro';
import IconInstagram from './IconInstagram.astro';
import type { Locale } from '../config/locales';
import { localeConfig } from '../config/locales';
import { brandAssets } from '../config/brandAssets';
import { contact } from '../config/contact';
import { ui } from '../i18n/ui';
import { getReviewsPath, getAboutPath, getAssortmentPath } from '../config/marketing';

interface Props {
  locale: Locale;
  linkSectionsToHome?: boolean;
  contactHref?: string;
  currentArea?: 'home' | 'assortment' | 'about' | 'blog' | 'reviews';
  languagePaths?: Partial<Record<Locale, string>>;
}
const { locale, linkSectionsToHome = false, currentArea = 'home', languagePaths, contactHref } = Astro.props;
const s = storefront(locale);
const u = ui[locale];
const home = localeConfig[locale].path;
const sectionHref = (anchor: string) => `${linkSectionsToHome ? home : ''}${anchor}`;
const nav = [
  { href: getAssortmentPath(locale), label: s('Oferta'), area: 'assortment' },
  { href: getAboutPath(locale), label: s('O nas'), area: 'about' },
  { href: sectionHref('#jak-zamowic'), label: s('Jak zamówić') },
  ...(import.meta.env.DEV ? [{ href: getReviewsPath(locale), label: s('Opinie'), area: 'reviews' }] : []),
  { href: `${home}blog/`, label: s('Blog'), area: 'blog' },
];
const phoneHref = `tel:${contact.phoneE164}`;
---

<TopBar locale={locale} languagePaths={languagePaths} />
<header class="site-header">
  <div class="header-inner container">
    <a href={localeConfig[locale].path} class="logo-link" aria-label={`EuroSortex Group — ${u.home}`}>
      <Image src={imageAsset(brandAssets.logo)} alt="EuroSortex Group" class="logo" width={112} height={112} widths={[64, 112, 224]} sizes="56px" format="webp" loading="eager" />
      <span class="logo-name" aria-hidden="true">EuroSortex<span>Group</span></span>
    </a>

    <nav class="header-nav" aria-label={u.mainNav}>
      {nav.map((item) => (
        <a href={item.href} aria-current={item.area === currentArea ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a
        class="header-instagram"
        href={contact.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram — EuroSortex Group"
        data-analytics-placement="header"
      >
        <IconInstagram size={21} />
      </a>

      <a
        class="header-cta btn btn-primary"
        href={contactHref ?? sectionHref('#kontakt')}
        data-analytics-placement="header"
      >

        {s('Kontakt')}
      </a>

      <button
        type="button"
        class="menu-trigger"
        aria-label={u.menu}
        aria-expanded="false"
        aria-controls="menu-panel"
      >
        <svg class="icon-burger" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="menu-backdrop" hidden></div>
  <div class="menu-panel" id="menu-panel" hidden>
    <nav aria-label={u.menu}>
      {nav.map((item) => (
        <a href={item.href} aria-current={item.area === currentArea ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="menu-contact">
      <a href={phoneHref} class="menu-phone" data-analytics-placement="header">tel. {contact.phoneDisplay}</a>
      <a
        href={contact.instagramUrl}
        class="menu-instagram"
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-placement="header"
      >
        <IconInstagram size={20} />
        Instagram
      </a>
      <a
        class="btn btn-primary menu-cta"
        href={contactHref ?? sectionHref('#kontakt')}
        data-analytics-placement="header"
      >

        {s('Zapytaj o ofertę')}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 60px;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: none;
  }

  .logo-name {
    display: flex;
    flex-direction: column;
    gap: 3px;
    color: #062653;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.1;
    white-space: nowrap;
  }

  .logo-name span {
    color: var(--green);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .logo {
    height: 56px;
    width: auto;
    display: block;
  }

  .header-nav {
    display: none;
  }

  .header-nav a[aria-current='page'],
  .menu-panel nav a[aria-current='page'] {
    color: var(--green);
    font-weight: 800;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .header-instagram {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    flex: none;
    color: var(--text-soft);
  }

  .header-instagram:hover {
    color: var(--green);
  }

  .header-cta {
    display: none;
    min-height: 44px;
    padding: 0 18px;
    font-size: 15px;
    border-radius: 8px;
  }

  .menu-trigger {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: var(--text-strong);
  }

  .menu-trigger:hover {
    background: var(--surface-cream);
  }

  .menu-trigger .icon-close {
    display: none;
  }

  .menu-trigger[aria-expanded='true'] {
    background: var(--surface-cream);
  }

  .menu-trigger[aria-expanded='true'] .icon-burger {
    display: none;
  }

  .menu-trigger[aria-expanded='true'] .icon-close {
    display: block;
  }

  /* dropdown menu (mobile + tablet) */
  .menu-backdrop {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 100vh;
    background: rgba(43, 43, 40, 0.35);
    z-index: 43;
  }

  .menu-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border-strong);
    box-shadow: 0 12px 24px rgba(43, 43, 40, 0.12);
    z-index: 44;
  }

  .menu-panel nav {
    display: flex;
    flex-direction: column;
    padding: 8px 16px;
  }

  .menu-panel nav > a {
    display: flex;
    align-items: center;
    min-height: 48px;
    width: 100%;
    font-size: 17px;
    font-weight: 700;
    color: var(--text-strong);
    border-bottom: 1px solid var(--border-soft);
  }

  .menu-panel nav > a:last-child {
    border-bottom: 0;
  }

  .menu-panel nav > a:hover {
    color: var(--green);
  }

  .menu-contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px 16px 16px;
    border-top: 1px solid var(--border);
  }

  .menu-phone {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-soft);
    padding: 6px 0;
  }

  .menu-instagram {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-soft);
  }

  .menu-instagram:hover {
    color: var(--green);
  }

  .menu-cta {
    height: 50px;
    font-size: 16px;
  }

  /* ---- tablet: 768–1023 ---- */
  @media (min-width: 768px) {
    .header-inner {
      height: 64px;
      gap: 14px;
    }

    .logo {
      height: 60px;
    }

    .header-actions {
      gap: 14px;
    }

    .header-cta {
      display: inline-flex;
    }

    .header-instagram {
      display: inline-flex;
    }

    .menu-panel nav {
      padding: 8px 32px 16px;
    }

    .menu-backdrop {
      display: none;
    }

    .menu-contact {
      display: none;
    }
  }

  /* ---- desktop: 1200+ ---- */
  @media (min-width: 1200px) {
    .header-inner {
      height: auto;
      padding-block: 12px;
      justify-content: flex-start;
      gap: 20px;
    }

    .logo {
      height: 56px;
    }

    .header-nav {
      display: flex;
      align-items: center;
      align-self: stretch;
      gap: 16px;
      font-size: 14px;
      font-weight: 600;
      margin-left: 4px;
    }

    .header-nav a {
      color: var(--text-mid);
    }

    .header-nav a:hover {
      color: var(--green);
    }

    .header-actions {
      margin-left: auto;
      gap: 10px;
    }

    .header-cta {
      padding: 11px 16px;
      min-height: 0;
    }

    .menu-trigger,
    .menu-panel,
    .menu-backdrop {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-panel {
      animation: drop-in 0.18s ease;
    }

    .menu-backdrop {
      animation: fade-in 0.18s ease;
    }

    @keyframes drop-in {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
    }

    @keyframes fade-in {
      from {
        opacity: 0;
      }
    }
  }

  .header-cta { border-radius: 2px; }
  @media(min-width: 1024px) { .header-inner { min-height: 84px; } .header-nav { gap: 28px; } }

  @media(min-width: 1200px) { .header-nav { margin-left: 48px; } .header-inner { gap: 16px; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const menuTrigger = header.querySelector<HTMLButtonElement>('.menu-trigger')!;
  const menuPanel = header.querySelector<HTMLElement>('.menu-panel')!;
  const menuBackdrop = header.querySelector<HTMLElement>('.menu-backdrop')!;
  function setMenu(open: boolean) {
    menuPanel.hidden = !open;
    menuBackdrop.hidden = !open;
    menuTrigger.setAttribute('aria-expanded', String(open));
  }

  const menuOpen = () => !menuPanel.hidden;

  menuTrigger.addEventListener('click', () => setMenu(!menuOpen()));
  menuBackdrop.addEventListener('click', () => setMenu(false));

  // a tap on a section link should close the menu before scrolling
  menuPanel.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (menuOpen()) {
      setMenu(false);
      menuTrigger.focus();
    }
  });
</script>
