---
import type { Locale } from '../config/locales';
import { storefront } from '../i18n/storefront';
import { getAboutPath } from '../config/marketing';
import QuoteForm from './QuoteForm.astro';
import IconWhatsApp from './IconWhatsApp.astro';
import { company, contact, whatsappUrl } from '../config/contact';

interface Props { locale?: Locale }
const { locale = 'pl' } = Astro.props;
const s = storefront(locale);
---

<section class="quote-section" id="kontakt" aria-labelledby="quote-title">
  <div class="container quote-grid">
    <header class="quote-copy">
      <span class="kicker">{s("KONTAKT")}</span>
      <h2 id="quote-title">{s("Zapytaj o ofertę")}<br />{s("dla swojego sklepu.")}</h2>
      <p>{s("Zostaw kontakt. Omówimy dostępny asortyment, ilość i warunki dostawy.")}</p>
      <div class="whatsapp-contact">
        <h3>{s("Wolisz napisać na WhatsApp?")}</h3>
        <p>{s("Wyślij listę interesujących Cię towarów lub po prostu zadaj pytanie.")}</p>
        <a class="whatsapp-link" href={whatsappUrl('general', locale)} data-analytics-whatsapp data-analytics-placement="final_cta"><IconWhatsApp size={20} /> {s("Napisz na WhatsApp")} <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <QuoteForm locale={locale} />
    <div class="quote-contact-details">
      <dl class="direct-contact">
        <div><dt>{s("Telefon")}</dt><dd><a href={`tel:${contact.phoneE164}`} data-analytics-placement="final_cta">{contact.phoneDisplay}</a></dd></div>
        <div><dt>E-mail</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
      </dl>
      <div class="company-proof">
        <span class="kicker">{s("MAGAZYN W WARSZAWIE")}</span>
        <address>{company.warehouse.street}<br />{company.warehouse.postalCode} {company.warehouse.city}<br />{contact.workingDays[locale]} {contact.workingHours}</address>
        <a href={getAboutPath(locale)}>{s("Poznaj EuroSortex →")}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .quote-section { padding-block: var(--section-space); border-top: 1px solid var(--border); background: var(--surface-cream); }
  .quote-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); grid-template-areas: 'intro form' 'contacts form'; column-gap: 72px; row-gap: 36px; align-items: start; }
  .quote-copy { grid-area: intro; }
  .quote-grid > :global(.quote-form) { grid-area: form; }
  .quote-contact-details { grid-area: contacts; max-width: 430px; }
  h2 { font-weight: 600; letter-spacing: -.035em; margin: 16px 0 20px; color: var(--text-strong); font-size: var(--heading-section); line-height: 1.16; text-wrap: pretty; }
  .quote-copy > p { margin: 0; color: var(--text-soft); font-size: 15px; line-height: 1.8; max-width: 43ch; }
  .whatsapp-contact { margin-top: 32px; }
  .whatsapp-contact h3 { margin: 0 0 8px; color: var(--text-strong); font-size: 16px; font-weight: 600; }
  .whatsapp-contact p { max-width: 43ch; margin: 0 0 18px; color: var(--text-soft); font-size: 13px; line-height: 1.7; }
  .whatsapp-link { display: inline-flex; align-items: center; gap: 12px; min-height: 48px; padding: 12px 18px; border: 1px solid var(--green); color: var(--green); font-size: 13px; font-weight: 600; }
  .whatsapp-link > span { margin-left: 24px; }
  .whatsapp-link:hover { background: var(--green-soft); }
  .direct-contact { margin: 0; padding-top: 22px; border-top: 1px solid var(--border-strong); }
  .direct-contact > div { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 16px; margin-bottom: 14px; }
  dt { padding-top: 2px; color: var(--text-muted); font-size: 12px; }
  dd { margin: 0; }
  .direct-contact a { color: var(--text-strong); overflow-wrap: anywhere; font-size: 14px; font-weight: 600; }
  .direct-contact a:hover { color: var(--green); text-decoration: underline; }
  .company-proof { margin-top: 26px; }
  .company-proof .kicker { font-size: 10px; }
  address { margin: 10px 0 12px; color: var(--text-soft); font-size: 13px; font-style: normal; line-height: 1.7; }
  .company-proof a { font-size: 12px; text-decoration: underline; text-underline-offset: 4px; }
  @media(max-width: 1099px) { .quote-grid { column-gap: 36px; } }
  @media(max-width: 899px) { .quote-grid { grid-template-columns: 1fr; grid-template-areas: 'intro' 'form' 'contacts'; gap: 28px; } .quote-contact-details { max-width: none; } .quote-copy > p { max-width: 56ch; } }
  @media(max-width: 599px) { .quote-copy > p { font-size: 14px; } .whatsapp-contact { margin-top: 24px; } .whatsapp-contact p { display: none; } .whatsapp-contact h3 { margin-bottom: 12px; } }
</style>
