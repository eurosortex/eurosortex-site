---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  label: string;
}

const { items, label } = Astro.props;
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(item.href ?? Astro.url.pathname, Astro.site).href,
  })),
};
---

<nav class="breadcrumbs" aria-label={label}>
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        {index < items.length - 1 && <span class="separator" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

<style>
  .breadcrumbs {
    min-width: 0;
    color: var(--text-muted);
    font-size: 12.5px;
    font-weight: 700;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
  }

  a:hover {
    color: var(--green);
  }

  li:last-child span[aria-current='page'] {
    max-width: min(68vw, 560px);
    overflow: hidden;
    color: var(--text-soft);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .separator {
    color: var(--text-faint);
    font-weight: 500;
  }
</style>
