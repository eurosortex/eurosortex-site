---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { Locale } from '../config/locales';
import { localeConfig } from '../config/locales';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import StickyBar from './StickyBar.astro';
import BlogCard from './BlogCard.astro';
import IconWhatsApp from './IconWhatsApp.astro';
import { whatsappUrl } from '../config/contact';
import { blogCopy } from '../i18n/blog';
import { getBlogArticleAlternatePaths, getBlogArticlePath, getBlogEntrySlug, getBlogRoot, getPublishedBlogPosts } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: Locale;
}
const { post, locale } = Astro.props;
const copy = blogCopy[locale];
const slug = getBlogEntrySlug(post);
const alternatePaths = getBlogArticleAlternatePaths(slug);
const { Content, headings } = await render(post);
const tableOfContents = headings.filter((heading) => heading.depth === 2);
const allPosts = (await getPublishedBlogPosts(locale))
  .filter((item) => item.id !== post.id)
  .slice(0, 2);
const date = new Intl.DateTimeFormat(copy.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' }).format(post.data.publishedAt);
const articleUrl = new URL(getBlogArticlePath(locale, slug), Astro.site).href;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.image, Astro.site).href,
  datePublished: post.data.publishedAt.toISOString(),
  ...(post.data.updatedAt ? { dateModified: post.data.updatedAt.toISOString() } : {}),
  inLanguage: locale,
  mainEntityOfPage: articleUrl,
  publisher: { '@type': 'Organization', name: 'EuroSortex Group', url: new URL('/', Astro.site).href },
};
---

<Base
  title={`${post.data.title} | EuroSortex`}
  description={post.data.description}
  locale={locale}
  pageType="blog_article"
  alternatePaths={alternatePaths}
  ogType="article"
  image={post.data.image}
  publishedAt={post.data.publishedAt}
>
  <Header locale={locale} linkSectionsToHome currentArea="blog" languagePaths={alternatePaths} />
  <main id="tresc">
    <article>
      <header class="article-header">
        <div class="container article-header-inner">
          <a class="back-link" href={getBlogRoot(locale)}><span aria-hidden="true">←</span> {copy.backToArticles}</a>
          <div class="article-meta">
            <span>{post.data.category}</span>
            <span aria-hidden="true">·</span>
            <time datetime={post.data.publishedAt.toISOString()}>{date}</time>
            <span aria-hidden="true">·</span>
            <span>{post.data.readingTime} {copy.readingTime}</span>
          </div>
          <h1>{post.data.title}</h1>
          <p class="lead">{post.data.description}</p>
        </div>
      </header>

      <div class="container article-shell">
        <img class="article-image" src={post.data.image} alt={post.data.imageAlt} width="1200" height="720" decoding="async" />

        {tableOfContents.length > 0 && (
          <details class="mobile-toc">
            <summary>{copy.toc} <span aria-hidden="true">+</span></summary>
            <ol>{tableOfContents.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
          </details>
        )}

        <div class="article-layout">
          {tableOfContents.length > 0 && (
            <aside class="desktop-toc" aria-label={copy.toc}>
              <span class="mono-label">{copy.toc.toUpperCase()}</span>
              <ol>{tableOfContents.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
              <a class="toc-offer" href={`${localeConfig[locale].path}#oferta`}>{copy.viewOffer} <span aria-hidden="true">→</span></a>
            </aside>
          )}
          <div class="article-content">
            <Content />
          </div>
        </div>

        <aside class="article-cta" aria-label={copy.currentBatches}>
          <div>
            <span class="kicker">{copy.currentBatches}</span>
            <h2>{copy.articleCtaTitle}</h2>
            <p>{copy.articleCtaText}</p>
          </div>
          <a class="btn btn-primary" href={whatsappUrl('general', locale)} data-analytics-whatsapp data-analytics-placement="final_cta">
            <IconWhatsApp size={18} />
            {copy.whatsappAction}
          </a>
        </aside>
      </div>
    </article>

    {allPosts.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <div class="container">
          <h2 id="related-heading">{copy.related}</h2>
          <div class="related-grid">{allPosts.map((item) => <BlogCard post={item} locale={locale} />)}</div>
        </div>
      </section>
    )}
  </main>
  <Footer locale={locale} languagePaths={alternatePaths} />
  <StickyBar locale={locale} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
</Base>

<style>
  .article-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .article-header-inner {
    max-width: 1000px;
    padding-block: 34px 42px;
  }

  .back-link {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 28px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    color: var(--text-faint);
    font: 600 10.5px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 14px 0 16px;
    font-size: clamp(34px, 6vw, 58px);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text-strong);
    text-wrap: balance;
  }

  .lead {
    max-width: 760px;
    margin: 0;
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-soft);
  }

  .article-shell {
    max-width: 1000px;
    padding-block: 28px 56px;
  }

  .article-image {
    display: block;
    width: 100%;
    max-height: 510px;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .mobile-toc {
    margin-top: 24px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }

  .mobile-toc summary {
    min-height: 52px;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    list-style: none;
  }

  .mobile-toc summary::-webkit-details-marker {
    display: none;
  }

  .mobile-toc[open] summary {
    border-bottom: 1px solid var(--border);
  }

  .mobile-toc summary span {
    transition: transform 160ms ease;
  }

  .mobile-toc[open] summary span {
    transform: rotate(45deg);
  }

  .mobile-toc ol {
    margin: 0;
    padding: 12px 16px 15px 36px;
  }

  .mobile-toc li {
    padding: 5px 0 5px 4px;
    color: var(--text-muted);
    font-size: 13.5px;
  }

  .mobile-toc a {
    color: var(--text-mid);
  }

  .article-layout {
    margin-top: 0;
  }

  .desktop-toc {
    display: none;
  }

  .article-content {
    max-width: 760px;
    margin: 34px auto 0;
    font-size: 16.5px;
    line-height: 1.78;
    color: var(--text-mid);
  }

  .article-content :global(h2) {
    margin: 42px 0 14px;
    scroll-margin-top: 94px;
    font-size: 28px;
    line-height: 1.24;
    color: var(--text-strong);
  }

  .article-content :global(h3) {
    margin: 30px 0 10px;
    font-size: 21px;
    line-height: 1.3;
    color: var(--text-strong);
  }

  .article-content :global(p) {
    margin: 0 0 18px;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 22px;
    padding-left: 24px;
  }

  .article-content :global(li) {
    margin-bottom: 9px;
    padding-left: 4px;
  }

  .article-content :global(strong) {
    color: var(--text-strong);
  }

  .article-content :global(blockquote) {
    margin: 28px 0;
    padding: 18px 20px;
    border-left: 4px solid var(--green);
    background: var(--green-soft);
    color: var(--text-strong);
    border-radius: 0 10px 10px 0;
  }

  .article-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .article-cta {
    margin-top: 44px;
    padding: 26px 22px;
    background: var(--surface-cream);
    border: 1px solid var(--border-cream);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .article-cta h2 {
    margin: 8px 0 6px;
    font-size: 24px;
    line-height: 1.25;
    color: var(--text-strong);
  }

  .article-cta p {
    margin: 0;
    color: var(--text-soft);
  }

  .article-cta .btn {
    min-height: 50px;
    padding: 0 20px;
  }

  .related {
    padding-block: 48px 64px;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .related h2 {
    margin: 0 0 22px;
    font-size: 28px;
    color: var(--text-strong);
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (max-width: 767px) {
    .article-image {
      height: auto;
      max-height: none;
      object-position: center;
    }
  }

  @media (min-width: 768px) {
    .article-header-inner {
      padding-block: 54px 62px;
    }

    .article-shell {
      padding-block: 44px 76px;
    }

    .article-content {
      margin-top: 46px;
      font-size: 17px;
    }

    .article-cta {
      padding: 32px 36px;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 34px;
    }

    .article-cta .btn {
      flex: none;
    }

    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }
  }

  @media (min-width: 1024px) {
    .mobile-toc {
      display: none;
    }

    .article-layout {
      margin-top: 54px;
      display: grid;
      grid-template-columns: 210px minmax(0, 760px);
      gap: 64px;
      justify-content: center;
      align-items: start;
    }

    .desktop-toc {
      display: block;
      position: sticky;
      top: 96px;
      padding-top: 18px;
      border-top: 2px solid var(--green);
    }

    .desktop-toc ol {
      margin: 14px 0 0;
      padding: 0;
      list-style: none;
      counter-reset: toc;
    }

    .desktop-toc li {
      counter-increment: toc;
      border-bottom: 1px solid var(--border-soft);
    }

    .desktop-toc li a {
      padding: 10px 0;
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 7px;
      color: var(--text-muted);
      font-size: 12.5px;
      line-height: 1.45;
    }

    .desktop-toc li a::before {
      content: counter(toc, decimal-leading-zero);
      color: var(--text-faint);
      font: 600 9.5px var(--font-mono);
      padding-top: 3px;
    }

    .desktop-toc li a:hover {
      color: var(--green);
    }

    .toc-offer {
      margin-top: 16px;
      display: inline-flex;
      gap: 7px;
      font-size: 12.5px;
      font-weight: 800;
    }

    .article-content {
      margin: 0;
      max-width: none;
    }

    .article-cta {
      max-width: 1034px;
      margin-inline: auto;
      margin-top: 56px;
    }
  }
</style>
