---
import { Image } from 'astro:assets';
import { imageAsset } from '../lib/images';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { Locale } from '../config/locales';
import { localeConfig } from '../config/locales';
import { getAboutPath, getAssortmentPath } from '../config/marketing';
import { company } from '../config/contact';
import { ui } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import StickyBar from './StickyBar.astro';
import BlogCard from './BlogCard.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import BlogOffer from './BlogOffer.astro';
import { blogCopy } from '../i18n/blog';
import { getBlogArticleAlternatePaths, getBlogArticlePath, getBlogEntrySlug, getBlogRoot, getPublishedBlogPosts } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: Locale;
}
const { post, locale } = Astro.props;
const copy = blogCopy[locale];
const u = ui[locale];
const slug = getBlogEntrySlug(post);
const alternatePaths = getBlogArticleAlternatePaths(slug);
const { Content, headings } = await render(post);
const tableOfContents = headings.filter((heading) => heading.depth === 2);
const allPosts = (await getPublishedBlogPosts(locale))
  .filter((item) => item.id !== post.id)
  .slice(0, 2);
const date = new Intl.DateTimeFormat(copy.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' }).format(post.data.publishedAt);
const articleUrl = new URL(getBlogArticlePath(locale, slug), Astro.site).href;
const siteUrl = new URL('/', Astro.site).href;
const blogUrl = new URL(getBlogRoot(locale), Astro.site).href;
const organizationId = `${siteUrl}#organization`;
const seoTitle = post.data.title.includes('EuroSortex') ? post.data.title : `${post.data.title} | EuroSortex`;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.image, Astro.site).href,
  datePublished: post.data.publishedAt.toISOString(),
  ...(post.data.updatedAt ? { dateModified: post.data.updatedAt.toISOString() } : {}),
  inLanguage: locale,
  articleSection: post.data.category,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  isPartOf: { '@type': 'Blog', '@id': `${blogUrl}#blog`, name: copy.metaTitle.replace(' | EuroSortex', ''), url: blogUrl },
  author: { '@type': 'Organization', '@id': organizationId, name: company.brandName, url: new URL(getAboutPath(locale), Astro.site).href },
  publisher: { '@id': organizationId },
};
---

<Base
  title={seoTitle}
  description={post.data.description}
  locale={locale}
  pageType="blog_article"
  alternatePaths={alternatePaths}
  ogType="article"
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
>
  <Header locale={locale} linkSectionsToHome currentArea="blog" languagePaths={alternatePaths} />
  <main id="tresc">
    <article>
      <header class="article-header">
        <div class="container article-header-inner">
          <Breadcrumbs
            label={copy.breadcrumbLabel}
            items={[
              { label: u.home, href: localeConfig[locale].path },
              { label: copy.blogLabel, href: getBlogRoot(locale) },
              { label: post.data.title },
            ]}
          />
          <div class="article-hero-grid">
            <div class="article-hero-copy">
              <span class="kicker">{post.data.category}</span>
              <h1>{post.data.title}</h1>
              <p class="lead">{post.data.description}</p>
              <div class="article-meta">
                <time datetime={post.data.publishedAt.toISOString()}>{date}</time>
                <span aria-hidden="true">·</span>
                <span>{post.data.readingTime} {copy.readingTime}</span>
              </div>
              <p class="article-author">{copy.authorLabel}: <a href={getAboutPath(locale)}>{copy.authorName}</a></p>
            </div>
            <Image class="article-image" src={imageAsset(post.data.image)} alt={post.data.imageAlt} width={1000} widths={[320, 480, 768, 1000]} sizes="(max-width: 899px) calc(100vw - 32px), 44vw" format="webp" quality={80} loading="eager" fetchpriority="high" decoding="async" />
          </div>
        </div>
      </header>

      <div class="container article-shell">

        {tableOfContents.length > 0 && (
          <details class="mobile-toc">
            <summary>{copy.toc} <span aria-hidden="true">+</span></summary>
            <ol>{tableOfContents.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
          </details>
        )}

        <div class:list={["article-layout", { "without-toc": tableOfContents.length === 0 }]}>
          {tableOfContents.length > 0 && (
            <aside class="desktop-toc" aria-label={copy.toc}>
              <span class="mono-label">{copy.toc.toUpperCase()}</span>
              <ol>{tableOfContents.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
              <a class="toc-offer" href={getAssortmentPath(locale)}>{copy.viewOffer} <span aria-hidden="true">→</span></a>
            </aside>
          )}
          <div class="article-content">
            <Content />
          </div>
        </div>

        <div class="article-offer"><BlogOffer locale={locale} /></div>
      </div>
    </article>

    {allPosts.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <div class="container">
          <div class="related-heading"><h2 id="related-heading">{copy.related}</h2><a href={getBlogRoot(locale)}>{copy.backToArticles} <span aria-hidden="true">→</span></a></div>
          <div class="related-grid">{allPosts.map((item) => <BlogCard post={item} locale={locale} headingLevel="h3" />)}</div>
        </div>
      </section>
    )}
  </main>
  <Footer locale={locale} languagePaths={alternatePaths} />
  <StickyBar locale={locale} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
</Base>

<style>
  .article-header { border-bottom: 1px solid var(--border); }
  .article-header-inner { padding-block: 30px 48px; }
  .article-hero-grid { display: grid; gap: 30px; margin-top: 36px; align-items: center; }
  .article-hero-copy { min-width: 0; }
  h1 { margin: 16px 0 20px; color: var(--text-strong); font-size: clamp(32px, 3.7vw, 44px); font-weight: 600; line-height: 1.15; letter-spacing: -1px; text-wrap: pretty; }
  .lead { margin: 0; color: var(--text-soft); font-size: 16px; line-height: 1.75; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; color: var(--text-muted); font-size: 12px; line-height: 1.6; }
  .article-author { margin: 8px 0 0; color: var(--text-muted); font-size: 12px; }
  .article-author a { color: var(--green); }
  .article-author a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .article-image { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; background: var(--surface-cream); }
  .article-shell { padding-block: 40px 64px; }
  .mobile-toc { border-block: 1px solid var(--border); margin-bottom: 32px; }
  .mobile-toc summary { display: flex; align-items: center; justify-content: space-between; min-height: 56px; gap: 20px; list-style: none; cursor: pointer; font-size: 14px; font-weight: 600; }
  .mobile-toc summary::-webkit-details-marker { display: none; }
  .mobile-toc summary span { color: var(--green); font-size: 22px; font-weight: 400; }
  .mobile-toc[open] summary span { transform: rotate(45deg); }
  .mobile-toc ol { list-style: none; padding: 0 0 16px; margin: 0; }
  .mobile-toc a { display: block; padding: 10px 0; color: var(--text-soft); font-size: 14px; line-height: 1.6; }
  .mobile-toc a:hover { color: var(--green); }
  .desktop-toc { display: none; }
  .article-content { min-width: 0; max-width: 720px; margin-inline: auto; color: var(--text-mid); font-size: 16px; line-height: 1.85; overflow-wrap: break-word; }
  .article-content :global(h2) { margin: 44px 0 18px; scroll-margin-top: 112px; color: var(--text-strong); font-size: clamp(25px, 2.7vw, 31px); font-weight: 600; line-height: 1.3; letter-spacing: -.65px; text-wrap: pretty; }
  .article-content :global(h3) { margin: 28px 0 12px; color: var(--text-strong); font-size: 21px; font-weight: 600; line-height: 1.4; }
  .article-content :global(p) { margin: 0 0 20px; }
  .article-content :global(ul), .article-content :global(ol) { margin: 0 0 24px; padding-left: 24px; }
  .article-content :global(li) { margin-bottom: 10px; padding-left: 4px; }
  .article-content :global(li::marker) { color: var(--green); }
  .article-content :global(strong) { color: var(--text-strong); font-weight: 650; }
  .article-content :global(a) { text-decoration: underline; text-underline-offset: 4px; }
  .article-content :global(blockquote) { margin: 28px 0; padding: 20px 24px; border-left: 2px solid var(--green); background: var(--surface-cream); }
  .article-content :global(blockquote p:last-child) { margin-bottom: 0; }
  .article-content :global(img) { max-width: 100%; height: auto; }
  .article-content :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: 14px; margin-block: 24px; }
  .article-content :global(th), .article-content :global(td) { padding: 12px; border-bottom: 1px solid var(--border); text-align: left; }
  .article-offer { margin-top: 56px; }
  .related { padding-block: 56px 64px; border-top: 1px solid var(--border); }
  .related-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 30px; }
  .related-heading h2 { margin: 0; font-size: clamp(28px, 3vw, 36px); font-weight: 600; letter-spacing: -.8px; color: var(--text-strong); }
  .related-heading a { display: flex; align-items: center; gap: 20px; min-height: 44px; font-size: 14px; font-weight: 600; }
  .related-grid { display: grid; gap: 36px; }
  @media (min-width: 640px) { .related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) {
    .article-hero-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 56px; }
    .article-header-inner { padding-bottom: 56px; }
  }
  @media (min-width: 1024px) {
    .article-shell { padding-top: 56px; }
    .mobile-toc { display: none; }
    .article-layout { display: grid; grid-template-columns: 240px minmax(0, 720px); gap: clamp(48px, 6vw, 88px); align-items: start; justify-content: space-between; }
    .article-layout.without-toc { grid-template-columns: minmax(0, 720px); justify-content: center; }
    .desktop-toc { display: block; position: sticky; top: 112px; max-height: calc(100dvh - 144px); overflow-y: auto; padding-block: 16px; border-top: 1px solid var(--green); }
    .desktop-toc .mono-label { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: .08em; }
    .desktop-toc ol { list-style: none; padding: 0; margin: 14px 0 0; }
    .desktop-toc li { border-bottom: 1px solid var(--border-soft); }
    .desktop-toc li a { display: block; padding: 11px 0; color: var(--text-soft); font-size: 13px; line-height: 1.6; }
    .desktop-toc a:hover { color: var(--green); }
    .toc-offer { display: inline-flex; align-items: center; gap: 16px; min-height: 44px; margin-top: 12px; font-size: 13px; font-weight: 600; }
    .article-content { margin: 0; font-size: 17px; }
  }
  @media (max-width: 639px) { .article-header-inner { padding-top: 22px; } .article-hero-grid { margin-top: 28px; } .article-image { aspect-ratio: 3 / 2; } .related-heading { align-items: start; flex-direction: column; } }
</style>
