---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../config/locales';
import { blogCopy } from '../i18n/blog';
import { getBlogArticlePath, getBlogEntrySlug } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  locale?: Locale;
  featured?: boolean;
  index?: number;
}

const { post, locale = 'pl', featured = false, index } = Astro.props;
const copy = blogCopy[locale];
const articlePath = getBlogArticlePath(locale, getBlogEntrySlug(post));
const date = new Intl.DateTimeFormat(copy.dateLocale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(post.data.publishedAt);
---

<article class:list={['blog-card', { 'is-featured': featured }]}>
  <a class="card-image-link" href={articlePath} aria-label={`${copy.readArticle}: ${post.data.title}`}>
    <img
      src={post.data.image}
      alt={post.data.imageAlt}
      width="960"
      height="640"
      loading={featured ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <div class="card-body">
    <div class="card-topline">
      <span class="category">{post.data.category}</span>
      {typeof index === 'number' && <span class="article-number" aria-hidden="true">{String(index).padStart(2, '0')}</span>}
    </div>
    <div class="card-meta">
      <time datetime={post.data.publishedAt.toISOString()}>{date}</time>
      <span aria-hidden="true">·</span>
      <span>{post.data.readingTime} {copy.minuteShort}</span>
    </div>
    <h2><a href={articlePath}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <a class="read-more" href={articlePath}>
      <span>{copy.readArticle}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .blog-card {
    min-width: 0;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .blog-card:hover {
    border-color: var(--border-strong);
    box-shadow: 0 16px 34px rgb(43 43 40 / 8%);
    transform: translateY(-2px);
  }

  .card-image-link {
    display: block;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  img {
    display: block;
    width: 100%;
    height: 210px;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .card-image-link:hover img {
    transform: scale(1.025);
  }

  .card-body {
    padding: 22px 20px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-topline {
    min-height: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .category {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--green-soft);
    color: var(--green);
    font: 700 10px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .article-number {
    color: var(--border-strong);
    font: 700 20px var(--font-mono);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
    font: 600 10.5px var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  h2 {
    margin: 10px 0 9px;
    font-size: 22px;
    line-height: 1.25;
  }

  h2 a {
    color: var(--text-strong);
  }

  h2 a:hover {
    color: var(--green);
  }

  p {
    margin: 0;
    color: var(--text-soft);
    font-size: 15px;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    margin-top: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 14.5px;
    font-weight: 800;
  }

  .arrow {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--green-soft);
    transition: transform 180ms ease, background 180ms ease;
  }

  .read-more:hover .arrow {
    transform: translateX(3px);
    background: var(--green-soft-hover);
  }

  @media (min-width: 768px) {
    .is-featured {
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
    }

    .is-featured .card-image-link {
      border-bottom: 0;
      border-right: 1px solid var(--border);
    }

    .is-featured img {
      height: 100%;
      min-height: 360px;
    }

    .is-featured .card-body {
      justify-content: center;
      padding: 38px;
    }

    .is-featured h2 {
      font-size: 30px;
    }

    .is-featured p {
      -webkit-line-clamp: 4;
    }
  }
</style>
