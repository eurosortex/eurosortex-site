---
import { Image } from 'astro:assets';
import { imageAsset } from '../lib/images';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../config/locales';
import { blogCopy } from '../i18n/blog';
import { getBlogArticlePath, getBlogEntrySlug } from '../lib/blog';

interface Props { post: CollectionEntry<'blog'>; locale: Locale; eager?: boolean; headingLevel?: 'h2' | 'h3' }
const { post, locale, eager = false, headingLevel: Heading = 'h2' } = Astro.props;
const copy = blogCopy[locale];
const articlePath = getBlogArticlePath(locale, getBlogEntrySlug(post));
const date = new Intl.DateTimeFormat(copy.dateLocale, { day: 'numeric', month: 'short', year: 'numeric' }).format(post.data.publishedAt);
---

<article class="blog-card">
  <a class="card-link" href={articlePath}>
    <div class="card-image">
      <Image src={imageAsset(post.data.image)} alt={post.data.imageAlt} width={800} widths={[320, 480, 640, 800, 960]} sizes="(max-width: 639px) calc(100vw - 32px), (max-width: 999px) 45vw, 380px" format="webp" quality={80} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </div>
    <div class="card-body">
      <span class="card-category">{post.data.category}</span>
      <Heading class="card-title">{post.data.title}</Heading>
      <p class="card-description">{post.data.description}</p>
      <div class="card-bottom">
        <span class="card-meta"><time datetime={post.data.publishedAt.toISOString()}>{date}</time><span aria-hidden="true">·</span><span>{post.data.readingTime} {copy.minuteShort}</span></span>
        <span class="read-more">{copy.readArticle}<span aria-hidden="true">↗</span></span>
      </div>
    </div>
  </a>
</article>

<style>
  .blog-card { min-width: 0; }
  .card-link { display: flex; flex-direction: column; height: 100%; color: var(--text); }
  .card-image { overflow: hidden; background: var(--surface-cream); }
  .card-image img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .card-body { display: flex; flex: 1; flex-direction: column; padding-top: 22px; }
  .card-category { color: var(--green); font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .card-title { margin: 12px 0; color: var(--text-strong); font-size: clamp(21px, 2.1vw, 25px); font-weight: 600; line-height: 1.3; letter-spacing: -.6px; text-wrap: pretty; }
  .card-description { margin: 0 0 24px; color: var(--text-soft); font-size: 14px; line-height: 1.7; }
  .card-bottom { display: flex; flex-direction: column; gap: 16px; margin-top: auto; }
  .card-meta { display: flex; flex-wrap: wrap; gap: 8px; color: var(--text-muted); font-size: 11px; line-height: 1.5; }
  .read-more { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 48px; border-top: 1px solid var(--border); color: var(--green); font-size: 13px; font-weight: 600; }
  .read-more > span { font-size: 20px; font-weight: 400; }
  .card-link:hover .card-title { color: var(--green); }
  .card-link:hover .read-more { border-color: var(--green); }
  .card-link:focus-visible { outline: 2px solid var(--green); outline-offset: 6px; }
  @media (prefers-reduced-motion: no-preference) {
    .card-image img { transition: transform .25s; }
    .card-link:hover img { transform: scale(1.025); }
  }
</style>
