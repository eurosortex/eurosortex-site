---
import type { Locale } from '../config/locales';
import { content } from '../i18n/content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Catalog from './Catalog.astro';
import Quality from './Quality.astro';
import Cooperation from './Cooperation.astro';
import Faq from './Faq.astro';
import FinalCta from './FinalCta.astro';
import Footer from './Footer.astro';
import StickyBar from './StickyBar.astro';
import FirstPurchase from './FirstPurchase.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];

---

<Base
  title={t.meta.title}
  description={t.meta.description}
  locale={locale}
  image="/images/catalog/urban-sweatshirts.jpg"
  imageAlt={t.hero.imageAlt}
>
  <Header locale={locale} />
  <main id="tresc">
    <Hero locale={locale} lead={locale === 'pl' ? 'Sortowana odzież i obuwie z Europy dla sklepów second-hand. Minimum 50 kg każdej pozycji. Magazyn w Warszawie, dostawa na terenie Polski.' : undefined} />
    <Catalog locale={locale} />
    {locale === 'pl' && <FirstPurchase />}
    <Quality locale={locale} />
    <Cooperation locale={locale} />
    <Faq locale={locale} />
    <FinalCta locale={locale} />
  </main>
  <Footer locale={locale} />
  <StickyBar locale={locale} />
</Base>
