---
import type { Locale } from '../config/locales';
import { content } from '../i18n/content';
import { company, contact } from '../config/contact';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Benefits from './Benefits.astro';
import Catalog from './Catalog.astro';
import Quality from './Quality.astro';
import PhotoCta from './PhotoCta.astro';
import Steps from './Steps.astro';
import Delivery from './Delivery.astro';
import OrderCta from './OrderCta.astro';
import Faq from './Faq.astro';
import FinalCta from './FinalCta.astro';
import Footer from './Footer.astro';
import StickyBar from './StickyBar.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];
const siteUrl = new URL('/', Astro.site).href;
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: company.brandName,
  legalName: company.legalName,
  url: siteUrl,
  description: t.meta.description,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/images/logo.png', Astro.site).href,
    width: 985,
    height: 258,
  },
  email: contact.email,
  telephone: contact.phoneE164,
  sameAs: [contact.instagramUrl],
  vatID: `PL${company.identifiers.nip}`,
  taxID: company.identifiers.nip,
  identifier: [
    { '@type': 'PropertyValue', propertyID: 'KRS', value: company.identifiers.krs },
    { '@type': 'PropertyValue', propertyID: 'REGON', value: company.identifiers.regon },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.registeredOffice.street,
    postalCode: company.registeredOffice.postalCode,
    addressLocality: company.registeredOffice.city,
    addressCountry: 'PL',
  },
  location: {
    '@type': 'Place',
    name: `${company.brandName} — magazyn`,
    address: {
      '@type': 'PostalAddress',
      streetAddress: company.warehouse.street,
      postalCode: company.warehouse.postalCode,
      addressLocality: company.warehouse.city,
      addressCountry: 'PL',
    },
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: contact.phoneE164,
    email: contact.email,
    contactType: 'sales',
    areaServed: 'PL',
    availableLanguage: ['pl', 'ru', 'uk', 'en'],
  },
  areaServed: { '@type': 'Country', name: 'Poland' },
};
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  locale={locale}
  image="/images/warehouse-hero.jpg"
  imageAlt={t.hero.imageAlt}
>
  <Header locale={locale} />
  <main id="tresc">
    <Hero locale={locale} />
    <Benefits locale={locale} />
    <Catalog locale={locale} />
    <Quality locale={locale} />
    <PhotoCta locale={locale} />
    <Steps locale={locale} />
    <Delivery locale={locale} />
    <OrderCta locale={locale} />
    <Faq locale={locale} />
    <FinalCta locale={locale} />
  </main>
  <Footer locale={locale} />
  <StickyBar locale={locale} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
</Base>
