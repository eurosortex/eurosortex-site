---
import { storefront, productLabel } from '../i18n/storefront';
import type { Locale } from '../config/locales';
import { Image } from 'astro:assets';
import { getAssortmentPath, getProductPath } from '../config/marketing';
import type { Product } from '../data/products';
import { imageAsset } from '../lib/images';
import CategoryLinks from './CategoryLinks.astro';

interface Props { products: Product[]; locale: Locale }
const { products, locale } = Astro.props;
const s = storefront(locale);
const descriptions: Record<string, string> = {
  'urban-sweatshirts': s("Bluzy damskie i męskie"),
  'winter-assortment': s("Odzież na chłodniejsze miesiące"),
  'mix-standart': s("Odzież, obuwie i dodatki"),
  'kids-wear': s("Dla dziewczynek i chłopców"),
};
---

<section class="assortment-preview" id="asortyment" aria-labelledby="assortment-preview-title">
  <div class="preview-heading">
    <h2 id="assortment-preview-title">{s("Poznaj nasz asortyment")}</h2>
    <a class="all-products" href={getAssortmentPath(locale)}>
      {s("Cały asortyment")}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" /></svg>
    </a>
  </div>
  <ul class="preview-products">
    {products.map((product) => (
      <li>
        <a class="preview-product" href={getProductPath(locale, product.id)} aria-labelledby={`preview-${product.id}`}>
          <div class="product-photo">
            {product.image && <Image src={imageAsset(product.image)} alt="" width={640} widths={[240, 360, 480, 640, 960]} sizes="(max-width: 599px) calc((100vw - 48px) / 2), (max-width: 999px) calc((100vw - 84px) / 2), (max-width: 1311px) calc((100vw - 124px) / 4), 295px" format="webp" quality={80} loading="lazy" decoding="async" />}
          </div>
          <div class="product-copy">
            <div class="product-title">
              <h3 id={`preview-${product.id}`}>{productLabel(locale, product.name)}</h3>
              <span class="product-arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" /></svg>
              </span>
            </div>
            <p>{descriptions[product.id] ?? product.description[locale]}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
  <CategoryLinks locale={locale} />
</section>

<style>
  .assortment-preview { margin-top: 64px; padding-top: 40px; border-top: 1px solid var(--border); }
  .preview-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  h2 { margin: 0; color: var(--text-strong); font-size: clamp(24px, 2.4vw, 30px); font-weight: 600; line-height: 1.2; letter-spacing: -.8px; }
  .all-products { display: inline-flex; align-items: center; gap: 16px; min-height: 44px; font-size: 14px; font-weight: 600; flex: none; }
  .all-products:hover { text-decoration: underline; text-underline-offset: 5px; }
  .preview-products { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .preview-products li { min-width: 0; }
  .preview-product { display: flex; flex-direction: column; height: 100%; border-radius: 10px; }
  .preview-product:focus-visible { outline-offset: 4px; }
  .product-photo { position: relative; overflow: hidden; aspect-ratio: 4 / 3; border-radius: 10px; background: var(--border-soft); }
  .product-photo img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  .product-copy { padding: 16px 0 4px; }
  .product-title { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  h3 { margin: 0; color: var(--text-strong); font-size: 20px; line-height: 1.3; letter-spacing: -.5px; font-weight: 650; }
  p { margin: 6px 0 0; color: var(--text-soft); font-size: 13px; line-height: 1.6; }
  .product-arrow { display: grid; place-items: center; flex: none; width: 30px; height: 30px; border: 1px solid var(--border); border-radius: 50%; color: var(--green); }
  .preview-product:hover h3 { color: var(--green); }
  .preview-product:hover .product-arrow { background: var(--green); border-color: var(--green); color: white; }
  @media (prefers-reduced-motion: no-preference) {
    .product-arrow { transition: background-color .2s, border-color .2s, color .2s; }
    .product-photo img { transition: transform .3s; }
    .preview-product:hover .product-photo img { transform: scale(1.035); }
  }
  @media (max-width: 999px) {
    .preview-products { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; }
  }
  @media (max-width: 599px) {
    .assortment-preview { margin-top: 40px; padding-top: 32px; }
    .preview-heading { align-items: start; flex-direction: column; gap: 8px; margin-bottom: 20px; }
    .all-products { min-height: 36px; font-size: 13px; }
    .preview-products { gap: 24px 16px; }
    .product-photo { border-radius: 8px; }
    .product-copy { padding-top: 12px; }
    .product-title { align-items: flex-start; }
    h3 { font-size: 16px; letter-spacing: -.3px; }
    p { font-size: 12px; line-height: 1.5; }
    .product-arrow { width: 24px; height: 24px; }
    .product-arrow svg { width: 14px; height: 14px; }
  }
</style>
