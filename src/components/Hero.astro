---
import { storefront } from '../i18n/storefront';
import { Image } from 'astro:assets';
import { imageAsset } from '../lib/images';
import { getAssortmentPath } from '../config/marketing';
import type { Locale } from '../config/locales';

interface Props { locale: Locale; lead?: string }
const { locale, lead } = Astro.props;
const s = storefront(locale);
---

<section class="hero">
  <Image class="hero-background" src={imageAsset('/images/hero-wholesale-v1.png')} alt="" width={1920} widths={[640, 960, 1280, 1600, 1920, 2560]} sizes="100vw" format="webp" quality={85} loading="eager" fetchpriority="high" />
  <div class="container hero-inner">
    <div class="hero-content">
      <span class="kicker">{s('EUROSORTEX GROUP · WARSZAWA')}</span>
      <h1>{s('Hurtownia odzieży używanej')} <span>{s('dla Twojego sklepu')}</span></h1>
      <p class="hero-lead">{lead ?? s('Sortowana odzież i obuwie z Europy. Zamówienia od 50 kg, z dostawą do sklepów second-hand w całej Polsce.')}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={getAssortmentPath(locale)}>{s('Zobacz ofertę')}</a>
        <a class="btn btn-secondary" href="#kontakt" data-analytics-placement="hero">{s('Kontakt')}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; background: #c3b9a8; }
  .hero-background { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 65% center; z-index: -2; }
  .hero::after { content: ''; position: absolute; inset: 0; background: rgb(15 24 18 / 12%); z-index: -1; }
  .hero-inner { min-height: 630px; display: flex; align-items: center; padding-block: 64px; }
  .hero-content { width: 560px; max-width: 100%; padding: 44px; background: #fff; }
  .kicker { color: var(--text-muted); font-size: 10px; letter-spacing: 1.7px; }
  h1 { margin: 24px 0; font-size: clamp(36px, 3.5vw, 48px); line-height: 1.13; letter-spacing: -1.6px; font-weight: 650; color: var(--text-strong); text-wrap: balance; }
  h1 span { color: var(--green); }
  .hero-lead { margin: 0; max-width: 42ch; font-size: 17px; line-height: 1.75; color: var(--text-soft); }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
  .hero-ctas .btn { min-height: 52px; padding: 12px 28px; font-size: 15px; }
  .hero-ctas .btn-secondary { border-color: var(--green); color: var(--green); }
  @media(max-width: 767px) {
    .hero-inner { min-height: 590px; align-items: end; padding-top: 156px; padding-bottom: 24px; }
    .hero-content { padding: 28px 24px; }
    .hero-background { object-position: 72% center; }
    h1 { font-size: 34px; letter-spacing: -1.2px; margin-block: 20px; }
    .hero-lead { font-size: 15px; line-height: 1.65; }
    .hero-ctas { margin-top: 26px; gap: 10px; }
    .hero-ctas .btn { flex: 1; padding-inline: 14px; font-size: 14px; }
  }
</style>
