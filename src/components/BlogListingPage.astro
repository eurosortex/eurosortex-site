---
import BlogCard from './BlogCard.astro';
import BlogOffer from './BlogOffer.astro';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../config/locales';
import { localeConfig } from '../config/locales';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import StickyBar from './StickyBar.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { blogCopy } from '../i18n/blog';
import { ui } from '../i18n/ui';
import { getBlogArticlePath, getBlogEntrySlug, getBlogPageAlternatePaths, getBlogPagePath } from '../lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
  locale: Locale;
  currentPage: number;
  totalPages: number;
}

const { posts, locale, currentPage, totalPages } = Astro.props;
const copy = blogCopy[locale];
const u = ui[locale];
const title = currentPage === 1 ? copy.metaTitle : `${copy.metaTitle.replace(' | EuroSortex', '')} — ${copy.pageLabel.toLowerCase()} ${currentPage} | EuroSortex`;
const description = copy.metaDescription;
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
const previousPath = currentPage > 1 ? getBlogPagePath(currentPage - 1, locale) : undefined;
const nextPath = currentPage < totalPages ? getBlogPagePath(currentPage + 1, locale) : undefined;
const alternatePaths = getBlogPageAlternatePaths(currentPage);
const pageUrl = new URL(getBlogPagePath(currentPage, locale), Astro.site).href;
const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${pageUrl}#blog`,
  name: currentPage === 1 ? copy.metaTitle.replace(' | EuroSortex', '') : `${copy.metaTitle.replace(' | EuroSortex', '')} — ${copy.pageLabel.toLowerCase()} ${currentPage}`,
  description,
  url: pageUrl,
  inLanguage: locale,
  publisher: { '@id': `${new URL('/', Astro.site).href}#organization` },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    '@id': `${new URL(getBlogArticlePath(locale, getBlogEntrySlug(post)), Astro.site).href}#article`,
    headline: post.data.title,
    url: new URL(getBlogArticlePath(locale, getBlogEntrySlug(post)), Astro.site).href,
    datePublished: post.data.publishedAt.toISOString(),
    image: new URL(post.data.image, Astro.site).href,
  })),
};
---

<Base
  title={title}
  description={description}
  locale={locale}
  pageType="blog_index"
  alternatePaths={alternatePaths}
  image="/images/warehouse-quality.jpg"
  imageAlt={copy.news}
>
  <Header locale={locale} linkSectionsToHome currentArea="blog" languagePaths={alternatePaths} />
  <main id="tresc">
    <section class="popular-section" id="popularne" aria-labelledby="popular-title">
      <div class="container">
        <Breadcrumbs
          label={copy.breadcrumbLabel}
          items={[
            { label: u.home, href: localeConfig[locale].path },
            { label: copy.blogLabel },
          ]}
        />
        <div class="popular-heading">
          <div><span class="kicker">{copy.latest}</span>
          <h1 id="popular-title">{copy.news}</h1></div>
          <p>{copy.intro}</p>
        </div>
        <div class="popular-grid">
          {posts.map((post, index) => <BlogCard post={post} locale={locale} eager={currentPage === 1 && index === 0} />)}
        </div>

        {posts.length === 0 && (
          <div class="empty-state" role="status">
            <strong>{copy.emptyTitle}</strong>
            <p>{copy.emptyText}</p>
          </div>
        )}

        {totalPages > 1 && (
          <nav class="pagination" aria-label={copy.pagesLabel}>
            <div class="pagination-pages">
              {previousPath ? (
                <a class="pagination-direction" href={previousPath} rel="prev" aria-label={copy.previousPage}><span aria-hidden="true">←</span></a>
              ) : (
                <span class="pagination-direction is-disabled" aria-disabled="true" aria-label={copy.noPreviousPage}><span aria-hidden="true">←</span></span>
              )}
              {pageNumbers.map((pageNumber) => (
                <a
                  class:list={['pagination-page', { 'is-current': pageNumber === currentPage }]}
                  href={getBlogPagePath(pageNumber, locale)}
                  aria-current={pageNumber === currentPage ? 'page' : undefined}
                  aria-label={`${copy.pageLabel} ${pageNumber}`}
                >{pageNumber}</a>
              ))}
              {nextPath ? (
                <a class="pagination-direction" href={nextPath} rel="next" aria-label={copy.nextPage}><span aria-hidden="true">→</span></a>
              ) : (
                <span class="pagination-direction is-disabled" aria-disabled="true" aria-label={copy.noNextPage}><span aria-hidden="true">→</span></span>
              )}
            </div>
          </nav>
        )}
      </div>
    </section>

    <section class="blog-cta"><div class="container"><BlogOffer locale={locale} /></div></section>
  </main>
  <Footer locale={locale} languagePaths={alternatePaths} />
  <StickyBar locale={locale} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
</Base>

<style>
  .popular-section { padding-block: 30px 64px; }
  .popular-heading { display: grid; gap: 20px; margin-top: 36px; padding-bottom: 40px; border-bottom: 1px solid var(--border); }
  h1 { max-width: 22ch; margin: 12px 0 0; color: var(--text-strong); font-size: clamp(32px, 4vw, 46px); font-weight: 600; line-height: 1.15; letter-spacing: -1.2px; text-wrap: pretty; }
  .popular-heading p { max-width: 48ch; margin: 0; color: var(--text-soft); font-size: 16px; line-height: 1.75; }
  .popular-grid { display: grid; grid-template-columns: 1fr; gap: 40px 32px; margin-top: 36px; }
  .empty-state { padding-block: 40px; color: var(--text-soft); }
  .empty-state strong { color: var(--text-strong); font-size: 24px; font-weight: 600; }
  .pagination { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--border); }
  .pagination-pages { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; }
  .pagination-direction, .pagination-page { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; border: 1px solid var(--border); color: var(--text-mid); font-size: 14px; font-weight: 600; }
  .pagination-direction:hover, .pagination-page:hover { background: var(--green-soft); }
  .pagination-page.is-current { background: var(--green); color: white; border-color: var(--green); }
  .pagination-direction.is-disabled { color: var(--text-muted); opacity: .5; }
  .blog-cta { padding-bottom: 64px; }
  @media (min-width: 640px) { .popular-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) {
    .popular-heading { grid-template-columns: 1.2fr .8fr; align-items: end; gap: 80px; padding-bottom: 44px; }
    .popular-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 36px; }
  }
  @media (max-width: 639px) { .popular-section { padding-top: 22px; } .popular-heading { margin-top: 28px; padding-bottom: 28px; } .popular-grid { margin-top: 28px; } }
</style>
