---
import AboutCompany from './AboutCompany.astro';
import type { Locale } from '../config/locales';
import { localeConfig } from '../config/locales';
import { getAboutAlternates } from '../config/marketing';
import { aboutCopy } from '../i18n/marketing';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import StickyBar from './StickyBar.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = aboutCopy[locale];
const alternates = getAboutAlternates();
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${pageUrl}#about`,
  url: pageUrl,
  name: c.metaTitle,
  description: c.metaDescription,
  inLanguage: locale === 'pl' ? 'pl-PL' : localeConfig[locale].htmlLang,
  ...(locale === 'pl' ? {
    spatialCoverage: { '@type': 'Country', name: 'Polska', identifier: 'PL' },
    audience: {
      '@type': 'BusinessAudience',
      audienceType: 'Właściciele sklepów z odzieżą używaną i sklepów second-hand w Polsce',
      geographicArea: { '@type': 'Country', name: 'Polska', identifier: 'PL' },
    },
    isPartOf: { '@id': `${new URL('/', Astro.site).href}#website` },
  } : {}),
  breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
  mainEntity: { '@id': `${new URL('/', Astro.site).href}#organization` },
};
---

<Base title={c.metaTitle} description={c.metaDescription} locale={locale} alternatePaths={alternates} pageType="about" image="/images/warehouse-quality.jpg" imageAlt={c.imageAlt}>
  <Header locale={locale} linkSectionsToHome currentArea="about" languagePaths={alternates} />
  <main id="tresc">
    <AboutCompany locale={locale} />
  </main>
  <Footer locale={locale} languagePaths={alternates} />
  <StickyBar locale={locale} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(aboutJsonLd)} />
</Base>
