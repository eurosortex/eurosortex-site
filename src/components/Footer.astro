---
import type { Locale } from '../config/locales';
import IconInstagram from './IconInstagram.astro';
import { localeConfig, locales } from '../config/locales';
import { getLegalPath } from '../config/legal';
import { company, contact } from '../config/contact';
import { content } from '../i18n/content';
import { consentCopy } from '../i18n/consent';
import { ui } from '../i18n/ui';
import { getAboutPath, getAssortmentPath } from '../config/marketing';

interface Props {
  locale: Locale;
  languagePaths?: Partial<Record<Locale, string>>;
}
const { locale, languagePaths } = Astro.props;
const t = content[locale];
const u = ui[locale];
const consent = consentCopy[locale];
const nav = [
  { href: getAssortmentPath(locale), label: t.nav.offer },
  { href: getAboutPath(locale), label: t.nav.about },
  { href: `${localeConfig[locale].path}#jakosc`, label: t.nav.quality },
  { href: `${localeConfig[locale].path}#jak-zamowic`, label: t.nav.process },
  { href: `${localeConfig[locale].path}#dostawa`, label: t.nav.terms },
  { href: `${localeConfig[locale].path}#faq`, label: t.nav.faq },
  { href: locale === 'pl' ? '/blog/' : `/${locale}/blog/`, label: t.nav.blog },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/images/logo.png" alt="EuroSortex Group" class="footer-logo" width="160" height="36" />
        <p>{t.footer.description}</p>
      </div>
      <nav class="footer-nav" aria-label={u.footerNav}>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="footer-contact">
        <span class="mono-label">{t.footer.contact}</span>
        <a href={`tel:${contact.phoneE164}`} data-analytics-placement="footer">tel. {contact.phoneDisplay}</a>
        <a href={`mailto:${contact.email}`} data-analytics-placement="footer">{contact.email}</a>
        <a
          class="footer-instagram"
          href={contact.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-placement="footer"
        >
          <IconInstagram size={20} />
          @eurosortexgroup
        </a>
      </div>
    </div>

    <section class="footer-company" aria-labelledby="company-details">
      <div class="footer-company-heading">
        <span class="mono-label" id="company-details">{t.footer.companyDetails}</span>
        <strong>{company.legalName}</strong>
      </div>

      <div class="footer-company-grid">
        <div class="footer-detail">
          <span class="detail-label">{t.footer.registeredOffice}</span>
          <address>
            {company.registeredOffice.street}<br />
            {company.registeredOffice.postalCode} {company.registeredOffice.city}
          </address>
        </div>

        <dl class="footer-identifiers">
          <div><dt>NIP</dt><dd>{company.identifiers.nip}</dd></div>
          <div><dt>KRS</dt><dd>{company.identifiers.krs}</dd></div>
          <div><dt>REGON</dt><dd>{company.identifiers.regon}</dd></div>
        </dl>

        <div class="footer-detail">
          <span class="detail-label">{t.footer.warehouse}</span>
          <address>
            {company.warehouse.street}<br />
            {company.warehouse.postalCode} {company.warehouse.city}
          </address>
        </div>

        <div class="footer-detail footer-registry">
          <span class="detail-label">{t.footer.registryCourt}</span>
          <span>{company.registryCourt}</span>
        </div>

        <div class="footer-detail">
          <span class="detail-label">{t.footer.shareCapital}</span>
          <span>{company.shareCapital}</span>
        </div>
      </div>
    </section>

    <nav class="footer-documents" aria-label={t.footer.legalDocuments}>
      <span class="mono-label">{t.footer.legalDocuments}</span>
      <div class="footer-document-links">
        <a href={getLegalPath(locale, 'privacy')}>{t.footer.privacy}</a>
        <a href={getLegalPath(locale, 'electronicServices')}>{t.footer.electronicServices}</a>
        <a href={getLegalPath(locale, 'salesTerms')}>{t.footer.salesTerms}</a>
      </div>
    </nav>

    <div class="footer-lang">
      <span class="mono-label">{u.language}</span>
      {locales.map((item, i) => (
        <>
          <a
            href={languagePaths?.[item] ?? localeConfig[item].path}
            lang={item}
            aria-current={item === locale ? 'page' : undefined}
            class:list={{ 'is-current': item === locale }}
            data-analytics-language-to={item}
            data-analytics-placement="footer"
          >
            {localeConfig[item].label}
          </a>
          {i < locales.length - 1 && <span class="dot" aria-hidden="true">·</span>}
        </>
      ))}
    </div>

    <div class="footer-legal">
      <span>© {year} {company.brandName}</span>
      <span>{company.legalName}</span>
      <button type="button" data-consent-open>{consent.reopen}</button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding-block: 28px 24px;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-logo {
    height: 36px;
    width: auto;
    display: block;
    align-self: flex-start;
  }

  .footer-brand p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
  }

  .footer-nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 15.5px;
    font-weight: 700;
    color: var(--text-mid);
    border-bottom: 1px solid var(--border-soft);
  }

  .footer-nav a:last-child {
    border-bottom: 0;
  }

  .footer-nav a:hover {
    color: var(--green);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--border-soft);
    padding-top: 14px;
  }

  .footer-contact a {
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
    min-height: 32px;
    display: flex;
    align-items: center;
  }

  .footer-contact a:hover {
    color: var(--green);
  }

  .footer-contact .footer-instagram {
    gap: 12px;
    width: fit-content;
  }

  .footer-company {
    border-top: 1px solid var(--border-soft);
    padding-top: 18px;
    margin-top: 20px;
  }

  .footer-company-heading {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 16px;
  }

  .footer-company-heading strong {
    font-size: 15px;
    line-height: 1.45;
    color: var(--text);
  }

  .footer-company-grid {
    display: grid;
    gap: 16px;
  }

  .footer-detail {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .detail-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .footer-detail address {
    font: inherit;
  }

  .footer-identifiers {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .footer-identifiers div {
    display: flex;
    gap: 8px;
  }

  .footer-identifiers dt {
    min-width: 46px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .footer-identifiers dd {
    margin: 0;
  }

  .footer-registry {
    max-width: 460px;
  }

  .footer-documents {
    display: grid;
    gap: 10px;
    border-top: 1px solid var(--border-soft);
    padding-top: 16px;
    margin-top: 18px;
  }

  .footer-document-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-document-links a {
    display: flex;
    align-items: center;
    min-height: 36px;
    width: fit-content;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text-soft);
  }

  .footer-document-links a:hover {
    color: var(--green);
  }

  .footer-lang {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    font-size: 14px;
    border-top: 1px solid var(--border-soft);
    padding-top: 14px;
    margin-top: 18px;
  }

  .footer-lang a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-weight: 600;
    color: var(--text-soft);
  }

  .footer-lang a:hover {
    color: var(--green);
  }

  .footer-lang a.is-current {
    font-weight: 800;
    color: var(--green);
  }

  .dot {
    color: var(--border-input);
  }

  .footer-legal {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--border-soft);
    padding-top: 14px;
    margin-top: 18px;
    font-size: 13.5px;
    color: var(--text-faint);
  }

  .footer-legal button {
    align-self: flex-start;
    min-height: 32px;
    color: var(--text-muted);
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-legal button:hover {
    color: var(--green);
  }

  @media (min-width: 768px) {
    .site-footer {
      padding-block: 32px 24px;
    }

    .footer-top {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 32px;
    }

    .footer-brand {
      flex: 1.2;
      min-width: 260px;
    }

    .footer-logo {
      height: 38px;
    }

    .footer-nav {
      flex: 1;
      min-width: 180px;
    }

    .footer-nav a {
      font-size: 15px;
    }

    .footer-contact {
      flex: 1;
      min-width: 220px;
      border-top: 0;
      padding-top: 0;
    }

    .footer-lang {
      margin-top: 20px;
    }

    .footer-company-grid {
      grid-template-columns: repeat(2, minmax(0, max-content));
      justify-content: start;
      gap: 20px 32px;
    }

    .footer-registry {
      grid-column: span 2;
    }

    .footer-document-links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px 24px;
    }

    .footer-legal {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 12px;
      margin-top: 20px;
    }
  }

  @media (min-width: 1024px) {
    .site-footer {
      padding-block: 36px 30px;
    }

    .footer-company-grid {
      grid-template-columns: repeat(3, minmax(0, max-content));
      gap: 20px 48px;
    }

    .footer-registry {
      grid-column: span 2;
    }
  }
</style>
