---
import { storefront } from '../i18n/storefront';
import { Image } from 'astro:assets';
import { imageAsset } from '../lib/images';
import type { Locale } from '../config/locales';
import IconInstagram from './IconInstagram.astro';
import { localeConfig, visibleLocales } from '../config/locales';
import { brandAssets } from '../config/brandAssets';
import { getLegalPath } from '../config/legal';
import { company, contact } from '../config/contact';
import { content } from '../i18n/content';
import { consentCopy } from '../i18n/consent';
import { ui } from '../i18n/ui';
import { getReviewsPath, getAboutPath, getAssortmentPath } from '../config/marketing';

interface Props {
  locale: Locale;
  languagePaths?: Partial<Record<Locale, string>>;
}
const { locale, languagePaths } = Astro.props;
const s = storefront(locale);
const t = content[locale];
const u = ui[locale];
const consent = consentCopy[locale];
const nav = [
  { href: getAssortmentPath(locale), label: s('Oferta') },
  { href: getAboutPath(locale), label: s('O nas') },
  { href: `${localeConfig[locale].path}#jak-zamowic`, label: s('Jak zamówić') },
  ...(import.meta.env.DEV ? [{ href: getReviewsPath(locale), label: s('Opinie') }] : []),
  { href: `${localeConfig[locale].path}blog/`, label: s('Blog') },
];
const year = new Date().getFullYear();
---

<footer class="site-footer footer-refined">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-brand-mark">
          <Image src={imageAsset(brandAssets.logo)} alt="EuroSortex Group" class="footer-logo" width={112} height={112} widths={[64, 112, 224]} sizes="64px" format="webp" loading="lazy" />
          <span class="footer-brand-name" aria-hidden="true">EuroSortex<span>Group</span></span>
        </div>
        <p>{t.footer.description}</p>
      </div>
      <nav class="footer-nav" aria-label={u.footerNav}>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="footer-contact">
        <span class="mono-label">{t.footer.contact}</span>
        <a href={`tel:${contact.phoneE164}`} data-analytics-placement="footer">tel. {contact.phoneDisplay}</a>
        <a href={`mailto:${contact.email}`} data-analytics-placement="footer">{contact.email}</a>
        <a
          class="footer-instagram"
          href={contact.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-placement="footer"
        >
          <IconInstagram size={20} />
          @eurosortexgroup
        </a>
      </div>
    </div>

    <details class="footer-company">
      <summary><span>{t.footer.companyDetails}</span><span class="company-summary-nip">NIP {company.identifiers.nip}</span><span class="company-toggle" aria-hidden="true">+</span></summary>
      <div class="footer-company-heading">
        <strong>{company.legalName}</strong>
      </div>

      <div class="footer-company-grid">
        <div class="footer-detail">
          <span class="detail-label">{t.footer.registeredOffice}</span>
          <address>
            {company.registeredOffice.street}<br />
            {company.registeredOffice.postalCode} {company.registeredOffice.city}
          </address>
        </div>

        <dl class="footer-identifiers">
          <div><dt>NIP</dt><dd>{company.identifiers.nip}</dd></div>
          <div><dt>KRS</dt><dd>{company.identifiers.krs}</dd></div>
          <div><dt>REGON</dt><dd>{company.identifiers.regon}</dd></div>
        </dl>

        <div class="footer-detail">
          <span class="detail-label">{t.footer.warehouse}</span>
          <address>
            {company.warehouse.street}<br />
            {company.warehouse.postalCode} {company.warehouse.city}
          </address>
        </div>

        <div class="footer-detail footer-registry">
          <span class="detail-label">{t.footer.registryCourt}</span>
          <span>{company.registryCourt}</span>
        </div>

        <div class="footer-detail">
          <span class="detail-label">{t.footer.shareCapital}</span>
          <span>{company.shareCapital}</span>
        </div>
      </div>
    </details>

    <div class="footer-meta"><nav class="footer-documents" aria-label={t.footer.legalDocuments}>
      <span class="mono-label">{t.footer.legalDocuments}</span>
      <div class="footer-document-links">
        <a href={getLegalPath(locale, 'privacy')}>{t.footer.privacy}</a>
        <a href={getLegalPath(locale, 'electronicServices')}>{t.footer.electronicServices}</a>
        <a href={getLegalPath(locale, 'salesTerms')}>{t.footer.salesTerms}</a>
      </div>
    </nav>

    <div class="footer-lang">
      <span class="mono-label">{u.language}</span>
      {visibleLocales.map((item, i) => (
        <>
          <a
            href={languagePaths?.[item] ?? localeConfig[item].path}
            lang={item}
            aria-current={item === locale ? 'page' : undefined}
            class:list={{ 'is-current': item === locale }}
            data-analytics-language-to={item}
            data-analytics-placement="footer"
          >
            {localeConfig[item].label}
          </a>
          {i < visibleLocales.length - 1 && <span class="dot" aria-hidden="true">·</span>}
        </>
      ))}
    </div>

    </div>

    <div class="footer-legal">
      <span>© {year} {company.brandName}</span>
      <button type="button" data-consent-open>{consent.reopen}</button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding-block: 28px 24px;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-brand-mark {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .footer-logo {
    height: 64px;
    width: auto;
    display: block;
    align-self: flex-start;
  }

  .footer-brand-name {
    display: flex;
    flex-direction: column;
    gap: 3px;
    color: #062653;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.1;
    white-space: nowrap;
  }

  .footer-brand-name span {
    color: var(--green);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .footer-brand p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
  }

  .footer-nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 15.5px;
    font-weight: 700;
    color: var(--text-mid);
    border-bottom: 1px solid var(--border-soft);
  }

  .footer-nav a:last-child {
    border-bottom: 0;
  }

  .footer-nav a:hover {
    color: var(--green);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--border-soft);
    padding-top: 14px;
  }

  .footer-contact a {
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
    min-height: 32px;
    display: flex;
    align-items: center;
  }

  .footer-contact a:hover {
    color: var(--green);
  }

  .footer-contact .footer-instagram {
    gap: 12px;
    width: fit-content;
  }

  .footer-company {
    border-top: 1px solid var(--border-soft);
    padding-top: 18px;
    margin-top: 20px;
  }

  .footer-company-heading {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 16px;
  }

  .footer-company-heading strong {
    font-size: 15px;
    line-height: 1.45;
    color: var(--text);
  }

  .footer-company-grid {
    display: grid;
    gap: 16px;
  }

  .footer-detail {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .detail-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .footer-detail address {
    font: inherit;
  }

  .footer-identifiers {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .footer-identifiers div {
    display: flex;
    gap: 8px;
  }

  .footer-identifiers dt {
    min-width: 46px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .footer-identifiers dd {
    margin: 0;
  }

  .footer-registry {
    max-width: 460px;
  }

  .footer-documents {
    display: grid;
    gap: 10px;
    border-top: 1px solid var(--border-soft);
    padding-top: 16px;
    margin-top: 18px;
  }

  .footer-document-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-document-links a {
    display: flex;
    align-items: center;
    min-height: 36px;
    width: fit-content;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text-soft);
  }

  .footer-document-links a:hover {
    color: var(--green);
  }

  .footer-lang {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    font-size: 14px;
    border-top: 1px solid var(--border-soft);
    padding-top: 14px;
    margin-top: 18px;
  }

  .footer-lang a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-weight: 600;
    color: var(--text-soft);
  }

  .footer-lang a:hover {
    color: var(--green);
  }

  .footer-lang a.is-current {
    font-weight: 800;
    color: var(--green);
  }

  .dot {
    color: var(--border-input);
  }

  .footer-legal {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--border-soft);
    padding-top: 14px;
    margin-top: 18px;
    font-size: 13.5px;
    color: var(--text-faint);
  }

  .footer-legal button {
    align-self: flex-start;
    min-height: 32px;
    color: var(--text-muted);
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-legal button:hover {
    color: var(--green);
  }

  @media (min-width: 768px) {
    .site-footer {
      padding-block: 32px 24px;
    }

    .footer-top {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 32px;
    }

    .footer-brand {
      flex: 1.2;
      min-width: 260px;
    }

    .footer-logo {
      height: 64px;
    }

    .footer-nav {
      flex: 1;
      min-width: 180px;
    }

    .footer-nav a {
      font-size: 15px;
    }

    .footer-contact {
      flex: 1;
      min-width: 220px;
      border-top: 0;
      padding-top: 0;
    }

    .footer-lang {
      margin-top: 20px;
    }

    .footer-company-grid {
      grid-template-columns: repeat(2, minmax(0, max-content));
      justify-content: start;
      gap: 20px 32px;
    }

    .footer-registry {
      grid-column: span 2;
    }

    .footer-document-links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px 24px;
    }

    .footer-legal {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 12px;
      margin-top: 20px;
    }
  }

  @media (min-width: 1024px) {
    .site-footer {
      padding-block: 36px 30px;
    }

    .footer-company-grid {
      grid-template-columns: repeat(3, minmax(0, max-content));
      gap: 20px 48px;
    }

    .footer-registry {
      grid-column: span 2;
    }
  }

  .footer-company summary { display: flex; align-items: center; gap: 20px; cursor: pointer; list-style: none; padding-block: 16px; color: var(--text-mid); font-size: 13px; }
  .footer-company summary::-webkit-details-marker { display: none; }
  .company-summary-nip { color: var(--text-muted); font-size: 12px; }
  .company-toggle { margin-left: auto; font-size: 22px; color: var(--green); }
  .footer-company[open] .company-toggle { transform: rotate(45deg); }
  .footer-company[open] .footer-company-heading { margin-top: 12px; }
  .footer-refined { padding-block: 48px 24px; }
  .footer-refined .footer-top { gap: 40px; }
  .footer-refined .footer-brand { max-width: 380px; gap: 16px; }
  .footer-refined .footer-brand p { font-size: 13px; max-width: 35ch; }
  .footer-refined .footer-logo { height: 48px; }
  .footer-refined .footer-nav { gap: 6px; }
  .footer-refined .footer-nav a { min-height: 30px; border: 0; font-size: 14px; font-weight: 500; }
  .footer-refined .footer-contact a { font-weight: 500; font-size: 14px; }
  .footer-refined .footer-company { padding: 0; margin-top: 32px; border-block: 1px solid var(--border); }
  .footer-refined .footer-company-grid { padding-bottom: 24px; }
  .footer-refined .footer-documents { border: 0; margin: 0; padding: 0; }
  .footer-refined .footer-documents > .mono-label { display: none; }
  .footer-refined .footer-document-links { gap: 0 20px; }
  .footer-refined .footer-document-links a { font-size: 12px; font-weight: 400; }
  .footer-refined .footer-lang { margin: 0; padding: 0; border: 0; font-size: 12px; }
  .footer-refined .footer-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 20px; }
  .footer-refined .footer-legal { font-size: 12px; margin-top: 20px; padding-top: 14px; }
  @media(min-width: 768px) {
    .footer-refined .footer-top { display: grid; grid-template-columns: 1.3fr .7fr 1fr; gap: 40px; }
    .footer-refined .footer-brand, .footer-refined .footer-nav, .footer-refined .footer-contact { min-width: 0; }
    .footer-refined .footer-contact a { overflow-wrap: anywhere; }
  }
  @media(max-width: 767px) {
    .footer-refined .footer-top { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .footer-refined .footer-brand { grid-column: 1 / -1; }
    .footer-refined .footer-contact { border: 0; padding: 0; gap: 8px; min-width: 0; }
    .footer-refined .footer-contact a { font-size: 12px; overflow-wrap: anywhere; }
    .footer-refined .footer-contact .footer-instagram { gap: 5px; }
    .footer-refined .footer-contact .footer-instagram svg { width: 15px; flex: none; }
  }
</style>
