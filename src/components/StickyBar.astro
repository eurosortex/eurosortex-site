---
import IconWhatsApp from './IconWhatsApp.astro';
import IconPhone from './IconPhone.astro';
import type { Locale } from '../config/locales';
import { contact, whatsappUrl, productWhatsappUrl } from '../config/contact';
import { content } from '../i18n/content';

interface Props { locale: Locale; productName?: string }
const { locale, productName } = Astro.props;
const t = content[locale];
---

<div class="sticky-bar">
  <a
    class="btn btn-primary bar-wa"
    href={productName ? productWhatsappUrl(productName, locale) : whatsappUrl('general', locale)}
    data-analytics-whatsapp
    data-analytics-placement="mobile_sticky"
  >
    <IconWhatsApp size={18} />
    WhatsApp
  </a>
  <a class="btn btn-secondary bar-call" href={`tel:${contact.phoneE164}`} data-analytics-placement="mobile_sticky">
    <IconPhone size={16} />
    {t.common.call}
  </a>
</div>

<style>
  /* Pinned to the viewport bottom while scrolling; being the last element in
     flow, it settles after the footer and never covers it. */
  .sticky-bar {
    position: sticky;
    bottom: 0;
    z-index: 46;
    background: var(--surface);
    border-top: 1px solid var(--border-strong);
    padding: 8px 16px calc(8px + env(safe-area-inset-bottom));
    min-height: 64px;
    display: flex;
    gap: 10px;
    box-shadow: none;
  }

  .bar-wa {
    flex: 1.5;
    height: 48px;
    font-size: 16px;
    font-weight: 600;
    gap: 8px;
  }

  .bar-call {
    flex: 1;
    height: 48px;
    font-size: 16px;
    gap: 8px;
  }

  @media (min-width: 768px) {
    .sticky-bar {
      padding-inline: 32px;
    }
  }

  @media (min-width: 768px) {
    .sticky-bar {
      display: none;
    }
  }
</style>
