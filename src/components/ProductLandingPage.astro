---
import { storefront, productLabel } from '../i18n/storefront';
import { Image } from 'astro:assets';
import { imageAsset } from '../lib/images';
import { localeConfig } from '../config/locales';
import { ui } from '../i18n/ui';
import type { Locale } from '../config/locales';
import { contact, productWhatsappUrl } from '../config/contact';
import QuoteForm from './QuoteForm.astro';
import { polishProductNames } from '../i18n/marketing';
import { getAssortmentPath, getProductAlternates, getProductPath } from '../config/marketing';
import type { Product } from '../data/products';
import { formatPrice, products } from '../data/products';
import { content } from '../i18n/content';
import { productEnhancementCopy, productPageCopy } from '../i18n/marketing';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import IconWhatsApp from './IconWhatsApp.astro';
import IconPhone from './IconPhone.astro';
import StickyBar from './StickyBar.astro';

interface Props { locale: Locale; product: Product }
const { locale, product } = Astro.props;
const s = storefront(locale);
const c = productPageCopy[locale];
const extra = productEnhancementCopy[locale];
const t = content[locale];
const alternates = getProductAlternates(product.id);
const assortmentPath = getAssortmentPath(locale);
const localizedName = productLabel(locale, product.name);
const whatsappHref = productWhatsappUrl(localizedName, locale);
const allFaq = c.faq(product);
const faq = [allFaq[1], allFaq[3]];
const related = [
  ...products.filter((item) => item.category === product.category && item.id !== product.id),
  ...products.filter((item) => item.category !== product.category),
].slice(0, 3);
const absoluteImage = product.image ? new URL(product.image, Astro.site).href : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${pageUrl}#product`,
  name: c.title(product.name),
  sku: product.id,
  ...(absoluteImage ? { image: [absoluteImage] } : {}),
  description: c.metaDescription(product),
  category: t.catalog.filters[product.category],
  itemCondition: 'https://schema.org/UsedCondition',
  offers: {
    '@type': 'Offer',
    url: pageUrl,
    eligibleRegion: { '@type': 'Country', name: 'Polska', identifier: 'PL' },
    priceCurrency: 'PLN',
    price: product.netPricePlnPerKg.toFixed(2),
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: product.netPricePlnPerKg.toFixed(2),
      priceCurrency: 'PLN',
      unitCode: 'KGM',
      unitText: 'kilogram',
      valueAddedTaxIncluded: false,
      referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'KGM' },
    },
    eligibleQuantity: { '@type': 'QuantitativeValue', minValue: 50, unitCode: 'KGM' },
    seller: { '@id': `${new URL('/', Astro.site).href}#organization` },
  },
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Base
  title={c.metaTitle(product.name)}
  description={c.metaDescription(product)}
  locale={locale}
  alternatePaths={alternates}
  pageType="product_landing"
  image={product.image}
  imageAlt={c.imageAlt(localizedName)}
>
  <Header locale={locale} linkSectionsToHome contactHref="#zapytanie" currentArea="assortment" languagePaths={alternates} />
  <main id="tresc">
    <article>
      <header class="product-hero product-hero-refined">
        <div class="container">
          <Breadcrumbs
            label={c.breadcrumb}
            items={[
              { label: ui[locale].home, href: localeConfig[locale].path },
              { label: t.nav.offer, href: assortmentPath },
              { label: localizedName },
            ]}
          />
          <div class="product-hero-grid">
            <div class="product-hero-copy">
              <span class="kicker">{c.eyebrow}</span>
              <h1>{locale === 'pl' ? c.title(product.name) : productLabel(locale, product.name)}</h1>
              <p class="product-lead">{product.description[locale]}</p>
              <div class="product-price-panel">
                <p class="product-unit-price"><strong>{formatPrice(product.netPricePlnPerKg, locale)}</strong> {s('zł/kg netto')} <span>+ VAT</span></p>
                <p>{s('Od 50 kg ·')} <strong>{formatPrice(product.netPricePlnPerKg * 50, locale)} {s('zł netto')}</strong> {s('+ VAT i transport')}</p>
                <span class="product-quality">{product.quality[locale]}</span>
              </div>
              <div class="product-actions">
                <a
                  class="btn btn-primary product-primary"
                  href="#zapytanie"
                  data-analytics-placement="product_landing_hero"
                  data-analytics-product-id={product.id}
                >

                  {c.enquire}
                </a>
                <a class="btn btn-secondary product-secondary" href={whatsappHref} data-analytics-whatsapp data-analytics-placement="product_landing_hero" data-analytics-product-id={product.id}>
                  <IconWhatsApp size={18} /> WhatsApp
                </a>
              </div>
              <p class="availability-note">{c.availabilityNote}</p>

              <p class="product-terms-note">{s("Dostawa w 1–3 tygodnie od 100% przedpłaty.")}</p>
            </div>
            <figure class="product-image-wrap">
              {product.image
                ? <Image src={imageAsset(product.image)} alt={c.imageAlt(localizedName)} width={960} widths={[320, 480, 768, 960, 1280]} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 50vw, 600px" format="webp" quality={80} loading="eager" fetchpriority="high" />
                : <div class="product-image-placeholder" aria-hidden="true">{product.name}</div>}
              {product.image && <figcaption>{s('Przykład asortymentu ·')} {localizedName}</figcaption>}
            </figure>
          </div>
        </div>
      </header>

      <section class="product-specs" aria-labelledby="product-data-title">
        <div class="container product-specs-grid">
          <div>
            <span class="kicker">01 / {t.catalog.filters[product.category]}</span>
            <h2 id="product-data-title">{c.productData}</h2>
            <div class="product-description">
              <p>{product.details[locale]}</p>
            </div>
          </div>
          <div class="specs-side">
            <dl class="product-table">
              <div><dt>{t.common.grade}</dt><dd>{product.quality[locale]}</dd></div>
              {product.composition && <div><dt>{c.composition}</dt><dd>{product.composition[locale]}</dd></div>}
              <div><dt>{t.common.branded}</dt><dd>{product.luxuryShareApprox}%</dd></div>
              {product.disposalShareMax && <div><dt>{c.disposal}</dt><dd>≤ {product.disposalShareMax}%</dd></div>}
            </dl>
            <section class="order-flow" aria-labelledby="order-flow-title">
              <h3 id="order-flow-title">{extra.orderTitle}</h3>
              <ol>
                {extra.orderSteps.map((step, index) => (
                  <li><span>0{index + 1}</span><p>{step}</p></li>
                ))}
              </ol>
            </section>
          </div>
        </div>
      </section>


      <section class="product-contact" id="kontakt">
        <div class="container contact-layout">
          <div class="contact-heading">
            <span class="kicker">{s('02 / WYCENA Z DOSTAWĄ')}</span>
            <h2>{extra.contactTitle}</h2>
            <p>{s('Zostaw kontakt. Potwierdzimy dostępną partię, prześlemy zdjęcia i omówimy dostawę.')}</p>
            <div class="contact-direct">
              <p>{s('Wolisz porozmawiać od razu?')}</p>
              <a class="contact-phone" href={`tel:${contact.phoneE164}`} data-analytics-placement="product_contact"><IconPhone size={20} />{contact.phoneDisplay}</a>
              <a class="contact-whatsapp" href={whatsappHref} data-analytics-whatsapp data-analytics-placement="product_contact" data-analytics-product-id={product.id}><IconWhatsApp size={20} />{s('Możesz też napisać na WhatsApp')} ↗</a>
            </div>
          </div>
          <QuoteForm locale={locale} product={product} placement="product_contact" />
        </div>
      </section>

      <section class="product-faq">
        <div class="container faq-grid">
          <div><span class="kicker">03 / {c.faqEyebrow}</span><h2>{c.faqTitle}</h2></div>
          <div class="faq-list">
            {faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
      <section class="related-section">
        <div class="container">
          <span class="kicker">04 / {c.relatedEyebrow}</span>
          <h2>{c.relatedTitle}</h2>
          <div class="related-grid">
            {related.map((item) => (
              <a class="related-card" href={getProductPath(locale, item.id)}>
                {item.image && <Image src={imageAsset(item.image)} alt={c.imageAlt(productLabel(locale, item.name))} width={480} widths={[320, 480, 768, 960, 1280]} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 50vw, 600px" format="webp" quality={80} loading="lazy" />}
                <span class="related-copy">
                  <strong>{locale === 'pl' ? polishProductNames[item.name] ?? item.name : productLabel(locale, item.name)}</strong>
                  <small>{item.description[locale]}</small>
                  <span>{c.relatedAction} →</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>

    </article>
  </main>
  <Footer locale={locale} languagePaths={alternates} />
  <StickyBar locale={locale} productName={localizedName} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Base>

<style>

  .product-hero { padding-block: 22px 36px; border-bottom: 1px solid var(--border); }
  .product-hero-grid { display: grid; gap: 28px; margin-top: 24px; }
  .product-hero-copy { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; gap: 15px; }
  h1, h2, h3, p { text-wrap: pretty; }
  h1 { margin: 0; max-width: 20ch; color: var(--text-strong); font-size: 35px; line-height: 1.1; font-weight: 800; letter-spacing: -.025em; }
  .product-lead { margin: 0; max-width: 60ch; color: var(--text-soft); font-size: 16px; line-height: 1.58; }
  .product-actions { display: flex; flex-direction: column; gap: 10px; width: 100%; }
  .product-primary, .product-secondary { min-height: 52px; padding: 0 20px; white-space: normal; text-align: center; }
  .availability-note { margin: -4px 0 0; max-width: 56ch; color: var(--text-muted); font-size: 13.5px; }
  .product-image-wrap { position: relative; align-self: start; width: 100%; aspect-ratio: 3 / 2; margin: 0; overflow: hidden; border: 1px solid var(--border); border-radius: 2px; background: var(--surface-cream); }
  .product-image-wrap img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }
  .product-image-placeholder { display: grid; place-items: end start; width: 100%; height: 100%; padding: 32px; background: linear-gradient(135deg, #e9e3d6, #d5dfd6 65%, #b4c9bd); color: var(--green); font-size: clamp(30px, 4vw, 54px); font-weight: 800; line-height: 1.05; }
  .product-image-wrap figcaption { position: absolute; right: 12px; bottom: 12px; padding: 7px 10px; border-radius: 6px; background: rgb(20 55 36 / 88%); color: #fff; font: 600 11px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .product-specs { padding-block: 40px; background: var(--surface); border-block: 1px solid var(--border); }
  .product-specs-grid { display: grid; gap: 22px; }
  .product-specs h2, .product-contact h2, .related-section h2, .product-faq h2 { margin: 8px 0 10px; color: var(--text-strong); font-size: 28px; line-height: 1.15; }
  .product-specs p { margin: 0; color: var(--text-soft); line-height: 1.65; }
  .product-description { display: grid; gap: 12px; }
  .specs-side { display: flex; min-width: 0; flex-direction: column; gap: 14px; }
  .product-table { margin: 0; overflow: hidden; border: 1px solid var(--border); border-radius: 2px; background: #fff; }
  .product-table div { display: grid; gap: 4px; padding: 12px 14px; border-bottom: 1px solid var(--border-soft); }
  .product-table div:last-child { border-bottom: 0; }
  .product-table dt { color: var(--text-faint); font: 600 10.5px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .product-table dd { margin: 0; color: var(--text-strong); font-size: 14.5px; font-weight: 700; }
  .order-flow { margin-top: 4px; padding: 18px 16px; border: 1px solid var(--border-cream); border-radius: 2px; background: var(--surface-cream); }
  .order-flow h3 { margin: 0 0 14px; color: var(--text-strong); font-size: 18px; }
  .order-flow ol { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .order-flow li { display: grid; grid-template-columns: 30px 1fr; align-items: start; gap: 10px; }
  .order-flow li > span { display: inline-flex; justify-content: center; align-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--green); color: #fff; font: 700 10px var(--font-mono); }
  .order-flow li p { padding-top: 3px; color: var(--text-soft); font-size: 14px; line-height: 1.5; }
  .product-contact { padding-block: 44px; background: var(--green-deep); }
  .product-contact .kicker { color: var(--green-pale); }
  .product-contact h2 { color: #fff; }
  .contact-heading { max-width: 720px; }
  .contact-heading > p { margin: 0; color: var(--green-pale-text); line-height: 1.65; }
  .contact-layout { display: grid; align-items: start; gap: 28px; }
  .contact-heading h2 { max-width: 18ch; }
  .contact-direct { display: grid; gap: 18px; margin-top: 32px; padding-top: 28px; border-top: 1px solid rgb(255 255 255 / 20%); color: #fff; }
  .contact-direct p { margin: 0; color: var(--green-pale-text); font-size: 14px; }
  .contact-direct a { display: inline-flex; align-items: center; gap: 12px; width: fit-content; }
  .contact-phone { color: #fff; font-size: clamp(22px, 2.5vw, 30px); font-weight: 600; }
  .contact-whatsapp { color: var(--green-pale-text); font-size: 14px; line-height: 1.6; }
  .contact-direct a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .related-section, .product-faq { padding-block: 44px; }
  .related-section { background: var(--surface-cream); border-block: 1px solid var(--border-cream); }
  .related-grid { display: grid; gap: 14px; margin-top: 22px; }
  .related-card { overflow: hidden; border: 1px solid var(--border); border-radius: 2px; background: #fff; color: var(--text); }
  .related-card:hover { border-color: var(--green-outline); color: var(--text); }
  .related-card img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; object-position: center; }
  .related-copy { display: flex; flex-direction: column; gap: 7px; padding: 15px; }
  .related-copy strong { color: var(--text-strong); font-size: 18px; }
  .related-copy small { color: var(--text-soft); font-size: 13.5px; line-height: 1.5; }
  .related-copy > span { margin-top: 3px; color: var(--green); font-size: 13.5px; font-weight: 800; }
  .faq-grid { display: grid; gap: 22px; }
  .faq-list { border-top: 1px solid var(--border); }
  details { border-bottom: 1px solid var(--border); }
  summary { position: relative; padding: 18px 38px 18px 0; color: var(--text-strong); font-weight: 800; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 15px; color: var(--green); font-size: 23px; }
  details[open] summary::after { content: '−'; }
  details p { margin: 0; padding: 0 28px 18px 0; color: var(--text-soft); font-size: 14.5px; line-height: 1.65; }
  @media (min-width: 768px) {
    .product-hero { padding-block: 28px 56px; }
    .product-hero-grid { grid-template-columns: minmax(0, 1.02fr) minmax(0, .98fr); align-items: start; gap: 40px; }
    .product-actions { flex-direction: row; flex-wrap: wrap; width: auto; }
    .product-specs-grid { grid-template-columns: .8fr 1.2fr; align-items: start; gap: 40px; }
    .contact-layout { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 48px; }
    .related-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .faq-grid { grid-template-columns: .7fr 1.3fr; gap: 48px; }
  }
  @media (min-width: 1024px) {
    .product-hero { padding-block: 30px 52px; }
    .product-hero-grid { grid-template-areas: 'copy image'; gap: 56px; margin-top: 30px; }
    .product-specs, .product-contact, .related-section, .product-faq { padding-block: 64px; }
    h1 { font-size: 44px; line-height: 1.12; }
    .product-lead { font-size: 18px; line-height: 1.6; }
    .product-specs h2, .product-contact h2, .related-section h2, .product-faq h2 { font-size: 34px; }
    .product-table div { grid-template-columns: 180px 1fr; gap: 20px; padding: 14px 16px; }
    .order-flow { padding: 22px; }
    .order-flow ol { grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .order-flow li { grid-template-columns: 1fr; gap: 8px; }
    .contact-layout { gap: 72px; }
  }

  .product-hero-refined h1 { font-weight: 600; font-size: clamp(32px, 3.5vw, 44px); letter-spacing: -1px; }
  .product-hero-refined .product-hero-copy { gap: 20px; }
  .product-hero-refined .product-lead { font-size: 16px; }
  .product-hero-refined .product-image-wrap { border: 0; border-radius: 0; aspect-ratio: auto; }
  .product-hero-refined .product-image-wrap img { height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .product-hero-refined .product-image-wrap figcaption { position: static; border-radius: 0; padding: 12px 0; font: 400 12px var(--font-sans); text-transform: none; letter-spacing: 0; color: var(--text-muted); background: #fff; }
  .product-price-panel { width: 100%; border-block: 1px solid var(--border); padding-block: 20px; }
  .product-price-panel p { margin: 0 0 10px; color: var(--text-soft); font-size: 14px; }
  .product-price-panel .product-unit-price { color: var(--text-strong); font-size: 16px; }
  .product-unit-price strong { font-size: 32px; font-weight: 600; }
  .product-unit-price span { color: var(--text-muted); font-size: 12px; margin-left: 8px; }
  .product-quality { color: var(--green); font-size: 13px; }
  .product-terms-note { margin: 0; font-size: 13px; color: var(--text-soft); }
  @media(max-width: 767px) { .product-hero-refined .product-hero-grid { gap: 20px; } }
  @media(min-width: 768px) { .product-hero-refined .product-hero-grid { grid-template-areas: 'image copy'; } .product-hero-refined .product-image-wrap { grid-area: image; } .product-hero-refined .product-hero-copy { grid-area: copy; } }
</style>
