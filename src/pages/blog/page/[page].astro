---
import type { GetStaticPaths } from 'astro';
import BlogListingPage from '../../../components/BlogListingPage.astro';
import { BLOG_PAGE_SIZE, getPublishedBlogPosts } from '../../../lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPublishedBlogPosts();
  const totalPages = Math.ceil(posts.length / BLOG_PAGE_SIZE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * BLOG_PAGE_SIZE;

    return {
      params: { page: String(currentPage) },
      props: {
        posts: posts.slice(start, start + BLOG_PAGE_SIZE),
        currentPage,
        totalPages,
      },
    };
  });
}) satisfies GetStaticPaths;

const { posts, currentPage, totalPages } = Astro.props;
---

<BlogListingPage posts={posts} locale="pl" currentPage={currentPage} totalPages={totalPages} />
